// Root tsconfig to set the settings and power editor support for all TS files
{
    // Base target/lib (es2022, lib es2024) and strict/esModuleInterop/moduleResolution for our
    // actual minimum supported Node.js version (engines.node: ">=22") instead of hand-picking
    // individual lib pieces ourselves - also makes "npm run check" fail loudly on the next major
    // bump if engines.node and this ever drift apart (see S0085/S0086/S0088 in the ioBroker
    // repository checker).
    "extends": "@tsconfig/node22/tsconfig.json",
    "compileOnSave": true,
    "compilerOptions": {
        // do not compile anything, this file is just to configure type checking
        "noEmit": true,

        // check JS files
        "allowJs": true,
        "checkJs": true,

        // This project is CommonJS (require/module.exports), not ESM - override the base's
        // "nodenext" module setting, which assumes the latter. TypeScript 7 removed the old
        // "node"/"node10" moduleResolution alias outright and ties "node16"/"nodenext"
        // resolution to the matching module setting, so "bundler" is the one mode that still
        // resolves plain extension-less requires() the way this (non-ESM, non-bundled) project
        // actually uses them, without inheriting the base's module/moduleResolution pairing.
        "module": "commonjs",
        "moduleResolution": "bundler",
        // this is necessary for the automatic typing of the adapter config
        "resolveJsonModule": true,

        // The base sets "strict": true; fine-tune just this one sub-flag instead of disabling
        // strict mode outright (not recommended).
        // "strictNullChecks": true,
        // "strictPropertyInitialization": true,
        // "strictBindCallApply": true,
        "noImplicitAny": false,
        // "noUnusedLocals": true,
        // "noUnusedParameters": true,
        "useUnknownInCatchVariables": false
    },
    "include": [
        "**/*.js",
        "**/*.d.ts"
    ],
    "exclude": [
        "node_modules/**"
    ]
}